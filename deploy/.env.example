# 复制为 deploy/.env 后填写。ASP.NET Core 环境变量用双下划线表示层级。

# --- 数据库（必填）---
Db__Base=Data Source=YOUR_HOST;Initial Catalog=YamBase;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;
Db__Bzss=Data Source=YOUR_HOST;Initial Catalog=YamBzss;User ID=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True;
Db__LogSql=false

# --- JWT（必填，至少 32 字符）---
Jwt__SecretKey=ChangeMe-At-Least-32-Bytes-Long-For-HS256-Algorithm!!
Jwt__Issuer=YamAuth
Jwt__Audience=YamAuth.Web

# --- 对外 URL ---
WEB_ORIGIN=http://localhost:8080
WEB_PORT=8080
API_PORT=6500

# --- RBAC ---
Rbac__SyncPermissionsOnStartup=false

# --- SMTP（找回密码；不用可设 Smtp__Enabled=false）---
Smtp__Enabled=false
Smtp__Host=smtp.example.com
Smtp__Port=465
Smtp__UseSsl=true
Smtp__UserName=
Smtp__Password=
Smtp__From=noreply@example.com
Smtp__FromName=YamAuth

# --- 可选：compose profile with-db 本地 SQL Server ---
# MSSQL_SA_PASSWORD=YourStrong!Passw0rd
# MSSQL_PORT=1433
