# syntax=docker/dockerfile:1

FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY YamAuth.sln ./
COPY src/YamAuth.Entity/ src/YamAuth.Entity/
COPY src/YamAuth.Repository/ src/YamAuth.Repository/
COPY src/YamAuth.Service/ src/YamAuth.Service/
COPY src/YamAuth.Api/ src/YamAuth.Api/

RUN dotnet restore src/YamAuth.Api/YamAuth.Api.csproj
RUN dotnet publish src/YamAuth.Api/YamAuth.Api.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS runtime
WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

ENV ASPNETCORE_URLS=http://+:8080
ENV ASPNETCORE_ENVIRONMENT=Production

COPY --from=build /app/publish .

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -fsS http://localhost:8080/health || exit 1

ENTRYPOINT ["dotnet", "YamAuth.Api.dll"]
